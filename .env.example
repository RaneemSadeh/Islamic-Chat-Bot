# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Google AI Studio key used by the React client (src/).
# https://aistudio.google.com/app/apikey
#
# This value is compiled into the browser bundle and is therefore public.
# Restrict it by HTTP referrer, and move it behind a server before shipping.
VITE_GEMINI_API_KEY=

# The RAG console (rag_console/) reads its keys from the sidebar at runtime,
# so nothing else is needed here. To skip typing them every run, export:
#   GROQ_API_KEY=
#   NOMIC_API_KEY=
